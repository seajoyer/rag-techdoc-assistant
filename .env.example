# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── Qdrant Cloud ──────────────────────────────────────────────────────────────
QDRANT_URL=
QDRANT_API_KEY=

# ── Groq (LLM) ───────────────────────────────────────────────────────────────
GROQ_API_KEY=

# ── HuggingFace (optional — only needed when EMBEDDER_MODE=hf or auto) ───────
HUGGINGFACEHUB_API_TOKEN=

# ── RAG pipeline ─────────────────────────────────────────────────────────────
COLLECTION_NAME=pytorch_docs
TOP_K=6
MAX_TOKENS=1024
TEMPERATURE=0.0

# HyDE: generate a hypothetical doc snippet before dense search (recommended)
HYDE_ENABLED=true

# ── Embedder mode ─────────────────────────────────────────────────────────────
# auto  → try local BGEM3Embedder first, fall back to HF Inference API
# local → always use local model (requires torch + FlagEmbedding)
# hf    → always use HuggingFace Inference API (requires HUGGINGFACEHUB_API_TOKEN)
EMBEDDER_MODE=auto

# ── Streaming ─────────────────────────────────────────────────────────────────
STREAMING_ENABLED=false
# Minimum seconds between successive sendMessageDraft calls (default: 0.5).
# Lower = more responsive preview; higher = fewer API calls.
STREAMING_DRAFT_INTERVAL=0.2

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Max requests per user within the rolling window
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW=60

# ── Access control (optional) ─────────────────────────────────────────────────
# Comma-separated Telegram user IDs allowed to use the bot.
# Leave empty to make the bot public.
# Example: ALLOWED_USER_IDS=123456789,987654321
ALLOWED_USER_IDS=

